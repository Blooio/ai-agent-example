# Anthropic API Key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API Key (for voice memo transcription via Whisper and DALL-E image generation)
# Optional - only needed if you want image generation and voice memo support
OPENAI_API_KEY=sk-xxx

# Blooio API Key (https://app.blooio.com)
BLOOIO_API_KEY=your_blooio_api_key

# Server
PORT=3000

# Sender phone numbers to ignore (comma-separated)
IGNORED_SENDERS=

# Only respond to these sender numbers (comma-separated) - useful for local dev to avoid double-replies
# Leave empty/unset to respond to everyone
ALLOWED_SENDERS=

# DynamoDB table name for conversation storage
DYNAMODB_TABLE_NAME=blooio-agent-example
